# 复制为 /opt/globuy/config/env.backend 后编辑；勿提交密钥。
# 域名 / HTTPS / CORS 说明：deploy/aliyun/DOMAIN_SETUP.md
#
# 启动（阿里云常见为 docker-compose 连字符；有 Compose V2 插件时可用 docker compose）：
#   docker-compose -f deploy/aliyun/docker-compose.stack.yml --env-file /opt/globuy/config/env.backend up -d --build

SPRING_PROFILES_ACTIVE=local,aliyun
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/voyage_db
SPRING_DATASOURCE_USERNAME=voyage_user
SPRING_DATASOURCE_PASSWORD=请设置强密码
POSTGRES_PASSWORD=请设置强密码

JWT_SECRET=请用足够长的随机串
# 生产域名（HTTPS）：与浏览器地址栏 Origin 一致，逗号分隔、无空格、勿加引号
# 主域统一（Nginx globuy.conf.https.example，.cyou 会 301 到 .com）：
APP_CORS_ALLOWED_ORIGINS=https://chzautokeys.com
# 双域并列（globuy.conf.https.dual-domain.example）示例：
# APP_CORS_ALLOWED_ORIGINS=https://chzautokeys.com,https://chzautokeys.cyou
# 本地调试可追加：,http://localhost:5173
# 仍用 IP 访问时保留：,http://公网IP

VOYAGE_MEDIA_STORAGE_ROOT=/data/media
API_PORT=8080
