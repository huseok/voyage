# sudo cp .../voyage/deploy/aliyun/nginx/globuy.conf.example /etc/nginx/sites-available/globuy
# 前端 dist 放到 /opt/globuy/www/frontend
#
# 域名：chzautokeys.com（主站）、chzautokeys.cyou（备用，可与主站同内容或 301 到 .com）
# DNS / HTTPS 申请步骤见 ../DOMAIN_SETUP.md

server {
    listen 80;
    listen [::]:80;
    server_name chzautokeys.com www.chzautokeys.com chzautokeys.cyou www.chzautokeys.cyou;

    root /opt/globuy/www/frontend;
    index index.html;

    # Let's Encrypt：^~ 优先于下方 SPA 的 try_files，避免校验 URL 落到 index.html
    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        root /var/www/certbot;
        allow all;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /media/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
