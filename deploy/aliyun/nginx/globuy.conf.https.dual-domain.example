# 双域名并列（.com 与 .cyou 均不 301 到对方）— 见 ../DOMAIN_SETUP.md §「双域名模式」
#   sudo cp .../globuy.conf.https.dual-domain.example /etc/nginx/sites-available/globuy
#   sudo nginx -t && sudo systemctl reload nginx
#
# CORS 须同时包含：https://chzautokeys.com,https://chzautokeys.cyou（及 www 若使用）

server {
    listen 80;
    listen [::]:80;
    server_name chzautokeys.com www.chzautokeys.com chzautokeys.cyou www.chzautokeys.cyou;

    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        root /var/www/certbot;
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name chzautokeys.com www.chzautokeys.com chzautokeys.cyou www.chzautokeys.cyou;

    ssl_certificate     /etc/letsencrypt/live/chzautokeys.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chzautokeys.com/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    root /opt/globuy/www/frontend;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /media/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
