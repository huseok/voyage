# 复制为 .env.docker.local
#
# 本地启动（推荐，不在 Docker 内编译）：
#   .\dev-up.ps1
#   或 .\scripts\docker-local-up.ps1
# 流程：本机 gradlew bootJar → Dockerfile.fast 只 COPY JAR → compose up（数秒）
# 勿单独 docker compose up --build（会复用旧 JAR，接口可能 403/404）。

DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
DOCKERFILE=Dockerfile.fast

SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/voyage_db
SPRING_DATASOURCE_USERNAME=voyage_user
SPRING_DATASOURCE_PASSWORD=change_me
POSTGRES_PASSWORD=change_me
JWT_SECRET=change_me_to_a_long_secret_for_prod

# DeepL 机器翻译（后台「一键翻译」、npm run i18n:sync）；不填则仅可手填 i18n 文案
# 免费版 Key 见 https://www.deepl.com/pro-api
# PayPal（可选；也可在后台 /admin/payment-settings 配置）
# VOYAGE_PAYPAL_CLIENT_ID=your-sandbox-client-id
# VOYAGE_PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
# VOYAGE_PAYPAL_WEBHOOK_ID=WH-...

# VOYAGE_I18N_API_KEY=your-deepl-api-key
# VOYAGE_I18N_API_URL=https://api-free.deepl.com
# 付费版：VOYAGE_I18N_API_URL=https://api.deepl.com

# 必须在容器内编译时（慢）：
# DOCKERFILE=Dockerfile
# 或：.\scripts\docker-local-up.ps1 -InDocker
