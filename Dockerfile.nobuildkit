# 未启用 BuildKit（DOCKER_BUILDKIT=0）时用此文件：无 cache mount，但仍用 gradle 命令避免下载 wrapper zip。
# docker compose ... build 时：$env:DOCKERFILE='Dockerfile.nobuildkit'
FROM gradle:8.14.4-jdk17 AS builder
WORKDIR /workspace

COPY gradle/ gradle/
COPY gradlew gradlew.bat build.gradle.kts settings.gradle.kts gradle.properties ./
RUN chmod +x gradlew

RUN gradle dependencies --no-daemon -q || true

COPY src/ src/

RUN gradle bootJar -x test --no-daemon --stacktrace --console=plain

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=builder /workspace/build/libs/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app.jar"]
